# Paper database: never in Git (the pre-built store is shared privately on request)
*.sqlite
*.sqlite*
*.db

# Your own settings: created from config.example.json on the first run, never committed
/config.json
/config.local.json

# Secrets and machine-specific files
.env
.env.*
.radar_token
.run.lock
.run.log
*.key

# Runtime output and logs
output/
radar.log
*.log
pending_pdf_queue.json
curation_marks*.json

# Python / OS
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
desktop.ini
